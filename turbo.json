{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CLERK_SECRET_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_PROXY_URL",
    "CLERK_WEBHOOK_SECRET"
  ],
  "globalDependencies": [
    ".env.local",
    "apps/web/postcss.config.mjs",
    "apps/web/tailwind.config.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!**/.next/cache/**"],
      "env": [
        "DATABASE_URL", "POSTGRES_URL", "POSTGRES_PRISMA_URL", "POSTGRES_URL_NON_POOLING", "POSTGRES_USER", "POSTGRES_HOST", "POSTGRES_PASSWORD", "POSTGRES_DATABASE",
        "SUPABASE_ANON_KEY", "SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY", "SUPABASE_JWT_SECRET", "SUPABASE_PUBLISHABLE_KEY", "SUPABASE_SECRET_KEY",
        "CLERK_WEBHOOK_SECRET", "SKIP_ENV_VALIDATION", "RESEND_API_KEY", "CLERK_SECRET_KEY", "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY", "NEXT_PUBLIC_CLERK_PROXY_URL", "CENSUS_API_KEY", "MAPBOX_ACCESS_TOKEN", "MELISSA_CUSTOMER_IDENT", "MELISSA_API_KEY", "TARGETED_LIST_PROVIDER", "EDDM_ROUTES_PROVIDER", "EDDM_ROUTES_API_URL", "EDDM_ROUTES_API_KEY", "MELISSA_BUYER_DOOR", "NEXT_PUBLIC_MELISSA_BUYER_DOOR", "VERCEL_ENV", "NEXT_PUBLIC_VERCEL_ENV", "ALLOW_TEST_ORDERS", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
