# Database
DATABASE_URL="postgresql://user:password@localhost:5432/postcard"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# Production-only Frontend API proxy (Clerk Hobby on *.vercel.app — no clerk.* CNAME).
# Do not set for Clerk development instances; proxying is production-only.
# Vercel Production (CIO, after merge):
# NEXT_PUBLIC_CLERK_PROXY_URL=https://postcard-platform-web.vercel.app/__clerk
NEXT_PUBLIC_CLERK_PROXY_URL=

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Postcard Platform <notifications@yourdomain.com>"

# File Uploads
UPLOADTHING_TOKEN=...

# Object Storage (Cloudflare R2)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=your-bucket
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Background Jobs
INNGEST_SIGNING_KEY=...

# AI (xAI)
XAI_API_KEY=xai-...

# Geo-targeting & Demographics (Census + Mapbox)
# Census API key — REQUIRED for the landing page interactive demo + targeting features
# This key powers the real Census ACS data shown in the map/targeting sections.
# Get free key: https://api.census.gov/data/key_signup.html
# IMPORTANT: Must be added to Vercel (Production + Preview) for the public demo to work.
CENSUS_API_KEY=

# Mapbox tokens (required for interactive maps + server geocoding)
# Public token (safe for browser / client-side maps)
# Get at: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# Secret token (server-side only - for geocoding, directions, etc.)
# IMPORTANT: Never expose this in client code. Use MAPBOX_ACCESS_TOKEN on server.
MAPBOX_ACCESS_TOKEN=sk.eyJ...

# Pricing (optional — default 35 cents / $0.35 per piece before size multiplier)
POSTCARD_BASE_RATE_CENTS=35

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SKIP_ENV_VALIDATION=

# Targeted lists — Melissa is the list door (not Census, not Data Axle)
# CIO: set on Vercel Production after Brett lands the license (do not invent a key).
TARGETED_LIST_PROVIDER=melissa
# LeadGen Occupant + Consumer `id=` / Customer Ident (numeric, e.g. 121046531).
# License Key as id= returns empty Geography. Required for Occupant EDDM + Consumer get/buy.
MELISSA_CUSTOMER_IDENT=
# License Key — NewMovers Data Retriever CustomerID. Fallback for Occupant/Consumer id= only.
MELISSA_API_KEY=

# EDDM carrier routes — Melissa Occupant (real routes, no STUB-CR)
# EDDM_ROUTES_PROVIDER=melissa
# (uses MELISSA_CUSTOMER_IDENT as Occupant id=; Occupant must be enabled on the account)
# Or an aggregator:
# EDDM_ROUTES_PROVIDER=http
# EDDM_ROUTES_API_URL=
# EDDM_ROUTES_API_KEY=

# MCP server (packages/mcp) — org-scoped agent access
# Production Streamable HTTP: https://postcard-platform-web.vercel.app/mcp
# Auth header only: Authorization: Bearer mcp_...  (never a query-string key)
# Issue a read,draft key (no spend/fulfill):
#   npm run issue-key -w @postcard-platform/mcp -- --org-id ... --user-email ... --name "Grok Bot" --scopes read,draft --spend-cap-cents 0
MCP_API_KEY=
MCP_HTTP_PORT=3333
MCP_HTTP_HOST=127.0.0.1
