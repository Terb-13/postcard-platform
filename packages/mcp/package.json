{
  "name": "@postcard-platform/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "postcard-mcp": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts --http",
    "start": "tsx src/index.ts --stdio",
    "start:http": "tsx src/index.ts --http",
    "issue-key": "tsx src/cli/issue-api-key.ts",
    "progress": "tsx src/index.ts --http --progress-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "echo 'Source package — run with tsx'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@postcard-platform/api": "*",
    "@postcard-platform/db": "*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
