# Copy to apps/web/.env.local (required for /sign-in and customer portal locally)

# Clerk — https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Supabase (Prisma) — see /supabase/README.md
DATABASE_URL=postgresql://postgres.onrvdowfqexfchjhysbm:...@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Optional: test orders without Stripe (defaults on in development + Vercel Preview)
ALLOW_TEST_ORDERS=true

# Preview Stripe **test** checkout (Melissa previewOnly drafts):
# Set on Vercel Preview only. Never live keys. Never flip Production MELISSA_BUYER_DOOR.
# Required: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...  STRIPE_SECRET_KEY=sk_test_...
# Optional: STRIPE_WEBHOOK_SECRET=whsec_...  (success page can activate without it on Preview)
# Escape hatch is on when VERCEL_ENV=preview (or ALLOW_TEST_ORDERS=true) AND secret is sk_test_.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Melissa buyer door — hard-off in Vercel Production. Preview defaults ON.
# Do not set MELISSA_BUYER_DOOR=1 on Production.
# MELISSA_BUYER_DOOR=1
# NEXT_PUBLIC_MELISSA_BUYER_DOOR=1
